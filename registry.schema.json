{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agentic Beaver Community Skills Registry",
  "type": "object",
  "required": ["registry", "owner", "version", "skills"],
  "properties": {
    "registry": { "type": "string" },
    "owner": { "type": "string" },
    "version": { "type": "string" },
    "updated": { "type": "string" },
    "description": { "type": "string" },
    "install": {
      "type": "object",
      "properties": {
        "how": { "type": "string" },
        "entrypoint": { "type": "string" }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "path", "entrypoint", "version", "description"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "name": { "type": "string" },
          "path": { "type": "string" },
          "entrypoint": { "type": "string" },
          "version": { "type": "string" },
          "description": { "type": "string" },
          "triggers": { "type": "array", "items": { "type": "string" } },
          "tags": { "type": "array", "items": { "type": "string" } },
          "maintainer": { "type": "string" },
          "source": { "type": "string" }
        }
      }
    }
  }
}
